# Copy to .env and fill in. .env is git-ignored.

# gemini | openai | mock
LLM_PROVIDER=gemini

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model ids (check with: python run.py models)
MODEL_STAGE_A=gemini-3.5-flash-lite
MODEL_STAGE_B=gemini-3.6-flash
# MODEL_LEAKAGE defaults to MODEL_STAGE_A

# Requests-per-minute throttles (defaults sit just under Gemini free-tier limits)
# RPM_STAGE_A=9
# RPM_STAGE_B=4
# RPM_LEAKAGE=9

# Stage B budget: ~20 Flash requests/day on the free tier; raise to 40+ on a paid key
STAGE_B_BUDGET=18

# For --provider openai (any OpenAI-compatible endpoint)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# MODEL_STAGE_A=gpt-4.1-mini
# MODEL_STAGE_B=gpt-4.1
